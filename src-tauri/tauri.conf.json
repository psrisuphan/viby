{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Viby",
  "version": "0.1.0",
  "identifier": "com.viby.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "Viby",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 680,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["target-reference/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "template.desktop",
        "files": {
          "/usr/share/applications/com.viby.app.desktop": "com.viby.app.desktop",
          "/usr/share/applications/viby.desktop": "viby.desktop",
          "/usr/share/icons/hicolor/32x32/apps/com.viby.app.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/apps/com.viby.app.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/com.viby.app.png": "icons/128x128@2x.png"
        }
      },
      "rpm": {
        "desktopTemplate": "template.desktop",
        "files": {
          "/usr/share/applications/com.viby.app.desktop": "com.viby.app.desktop",
          "/usr/share/applications/viby.desktop": "viby.desktop",
          "/usr/share/icons/hicolor/32x32/apps/com.viby.app.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/apps/com.viby.app.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/com.viby.app.png": "icons/128x128@2x.png"
        }
      }
    }
  }
}
