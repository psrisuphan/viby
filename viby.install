post_install() {
  # Remove stale Tauri-generated desktop entry (capital-V filename) that
  # tauri build --bundle creates when run manually. The PKGBUILD installs
  # viby.desktop (lowercase) so this duplicate must not coexist.
  rm -f /usr/share/applications/Viby.desktop
  update-desktop-database -q /usr/share/applications/ 2>/dev/null || true
}

post_upgrade() {
  post_install
}
